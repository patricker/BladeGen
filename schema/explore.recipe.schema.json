            "emissionGain": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          },
          "additionalProperties": false,
          "required": ["durationMs", "emissionGain"]
        },
        "emission": {
          "type": "object",
          "properties": {
            "starK": {
              "type": "number",
              "minimum": 2500,
              "maximum": 30000
            },
            "edgeStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 12
            },
            "channelStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 12
            }
          },
          "additionalProperties": false,
          "required": ["starK", "edgeStrength", "channelStrength"]
        },
        "scars": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
