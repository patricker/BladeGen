            "width": {
              "type": "number",
              "minimum": 0.03,
              "maximum": 0.09
            }
          },
          "additionalProperties": false,
          "required": ["branches", "width"]
        },
        "electrodes": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 2,
              "maximum": 6
            },
            "reach": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 1.8
            },
            "sink": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            }
          },
          "additionalProperties": false,
          "required": ["count", "reach", "sink"]
        }
      },
      "additionalProperties": false,
      "required": []
