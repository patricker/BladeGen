            "section": {
              "type": "number",
              "minimum": 0.07,
              "maximum": 0.16
            }
          },
          "additionalProperties": false,
          "required": ["standOff", "section"]
        },
        "strata": {
          "type": "object",
          "properties": {
            "layers": {
              "type": "integer",
              "minimum": 2,
              "maximum": 6
