            "sink": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.4
            },
            "projection": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.35
            }
          },
          "additionalProperties": false,
          "required": ["height", "sink", "projection"]
        },
        "terminator": {
          "type": "object",
          "properties": {
            "bias": {
              "type": "number",
              "minimum": -0.7,
              "maximum": 0.7
            }
          },
          "additionalProperties": false,
          "required": ["bias"]
        },
        "circuit": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
