            "section": {
              "type": "number",
              "minimum": 0.07,
              "maximum": 0.15
            },
            "bow": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            }
          },
          "additionalProperties": false,
          "required": ["count", "radius", "section", "bow"]
