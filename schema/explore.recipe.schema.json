            "bias": {
              "type": "number",
              "minimum": -0.1,
              "maximum": 0.1
            }
          },
          "additionalProperties": false,
          "required": ["separation", "mergeAt", "bias"]
        },
        "ribs": {
          "type": "object",
          "properties": {
            "pairs": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "reach": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1
            }
          },
          "additionalProperties": false,
          "required": ["pairs", "reach"]
        },
        "crystals": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "length": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.5
            },
            "width": {
              "type": "number",
              "minimum": 0.15,
              "maximum": 0.35
            }
          },
          "additionalProperties": false,
          "required": ["count", "length", "width"]
