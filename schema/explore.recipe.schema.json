{
  "type": "object",
  "properties": {
    "format": {
      "const": "bladegen-explore-recipe/1"
    },
    "recipeVersion": {
      "const": 1
    },
    "coreVersion": {
      "type": "string"
    },
    "mathProfile": {
      "const": "libm-f64-f32-v1"
    },
    "catalogueFnv1a64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "implementationFnv1a64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "base": {
      "type": "object",
      "required": ["blade", "guard", "handle", "pommel"],
      "description": "Validated Rust core Sword subset; not the editor document envelope."
    },
    "features": {
      "type": "object",
      "properties": {
        "resonance": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 9
            },
            "radius": {
              "type": "number",
              "minimum": 0.03,
              "maximum": 0.08
            }
          },
          "additionalProperties": false,
          "required": ["count", "radius"]
        },
        "read": {
          "type": "object",
          "properties": {
            "durationMs": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 15000
